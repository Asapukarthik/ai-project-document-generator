# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Powered Project Documentation Generator"
DEBUG=true
LOG_LEVEL=INFO

# Storage & Database
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/app.db

# Ollama LLM Configuration
# Default local Ollama endpoint. In Docker on Windows/Mac, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Recommended models: llama3.2, llama3.1, qwen2.5:7b, mistral
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# OCR Configuration
# If Tesseract is not in system PATH on Windows, provide the full binary path:
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux / Docker, leave empty to use default '/usr/bin/tesseract'.
TESSERACT_CMD=

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=25

# Backend API Configuration (for Streamlit frontend to reach FastAPI)
BACKEND_API_URL=http://localhost:8000
